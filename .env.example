# Base URL of your Jira Data Center instance (no trailing slash). Required.
JIRA_BASE_URL=https://jira.example.com

# Auth method: "pat" (Personal Access Token as bearer, Jira DC 8.14+) or "basic". Default: pat
JIRA_AUTH_METHOD=pat

# Used when JIRA_AUTH_METHOD=pat
JIRA_PAT=

# Used when JIRA_AUTH_METHOD=basic
JIRA_USERNAME=
JIRA_PASSWORD=

# Server mode. "read-only" exposes read tools only (default). "full" exposes write tools too.
JIRA_MCP_MODE=read-only

# Comma-separated tool names to hide regardless of mode. Example: jira_write_transition,jira_write_create_issue
JIRA_MCP_DISABLED_TOOLS=

# Label written to the audit log as the acting principal. Default: the OS username.
JIRA_MCP_PRINCIPAL=

# Path to the JSONL audit log. Every tool call is recorded (inputs hashed, never stored). Default: ./jira-dc-mcp.audit.jsonl
JIRA_MCP_AUDIT_LOG=./jira-dc-mcp.audit.jsonl

# Per-request timeout in milliseconds. Default: 15000
JIRA_TIMEOUT_MS=15000

# Hard cap on maxResults for any list/search tool. Default: 100
JIRA_MAX_RESULTS_CAP=100
