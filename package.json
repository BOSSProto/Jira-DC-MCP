{
  "name": "jira-dc-mcp",
  "version": "0.2.3",
  "description": "A permissioned, audited MCP server for Jira Data Center. Read by default; writes are explicit and confirmable.",
  "type": "module",
  "bin": { "jira-dc-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/index.js",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "tools": "npm run build && node dist/scripts/list-tools.js"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
